# Configuration of the ingest, normalize and conv services and the record
# tool. Every value below is the default of the code.
# An unset or empty variable takes its default. No secrets exist yet: the
# Redis password is empty by default.

# Kafka seed brokers, comma-separated host:port list.
THREADROUTE_KAFKA_BROKERS=localhost:9092

# Jetstream host read first (decision 0003).
THREADROUTE_SOURCE_PRIMARY_HOST=jetstream.us-east.bsky.network
# Jetstream host used when the primary host fails. Must differ from the primary.
THREADROUTE_SOURCE_FAILOVER_HOST=jetstream.us-west.bsky.network
# The only collection ingest subscribes to.
THREADROUTE_SOURCE_COLLECTION=app.bsky.feed.post

# Listen address (host:port) of the metrics and pprof endpoint. The default
# listens on all interfaces, so Prometheus can scrape it from another container.
THREADROUTE_METRICS_ADDR=:9464
# Log level: debug, info, warn or error.
THREADROUTE_LOG_LEVEL=info

# Most records the Kafka producer keeps in memory before a produce call blocks.
THREADROUTE_PRODUCER_MAX_BUFFERED_RECORDS=10000
# Most bytes the Kafka producer keeps in memory before a produce call blocks (32 MiB).
THREADROUTE_PRODUCER_MAX_BUFFERED_BYTES=33554432
# How long a record may wait for delivery before it fails and ingest restarts.
THREADROUTE_PRODUCER_DELIVERY_TIMEOUT=2m

# How long raw.bluesky keeps records. At least 1h (the segment interval).
THREADROUTE_RAW_RETENTION=24h
# Size limit of the whole raw.bluesky topic in bytes (8 GB), split over 6 partitions.
THREADROUTE_RAW_MAX_BYTES=8000000000

# ---------------------------------------------------------------------------
# Record tool (cmd/record). Recordings hold real post text and author IDs
# and must stay outside any git repository (decision 0004).

# Consumer group of the recorder.
THREADROUTE_RECORD_GROUP_ID=threadroute-record
# Where a new group starts reading: end or beginning.
THREADROUTE_RECORD_START=end
# Output directory, an absolute path. When empty, the default is
# $HOME/threadroute-recordings. In deploy/compose.yaml it is /recordings
# inside the container.
THREADROUTE_RECORD_DIR=
# A segment file is closed after this many uncompressed bytes (256 MiB).
THREADROUTE_RECORD_SEGMENT_MAX_BYTES=268435456
# A segment file is closed after this time.
THREADROUTE_RECORD_SEGMENT_MAX_AGE=1h
# Segment files older than this are deleted. At most 336h (14 days).
THREADROUTE_RECORD_RETENTION=336h
# Size limit of all segment files in bytes. Empty means no limit.
THREADROUTE_RECORD_MAX_TOTAL_BYTES=
# Listen address (host:port) of the recorder metrics, pprof and health endpoint.
THREADROUTE_RECORD_METRICS_ADDR=:9465
# Host directory that deploy/compose.yaml mounts as /recordings. Used only by
# compose. The default is $HOME/threadroute-recordings.
THREADROUTE_RECORD_HOST_DIR=

# ---------------------------------------------------------------------------
# Shared by normalize and conv. THREADROUTE_KAFKA_BROKERS and
# THREADROUTE_LOG_LEVEL above apply to them too.

# Redis address, host:port. Redis 7.0 or newer.
THREADROUTE_REDIS_ADDR=localhost:6379
# Redis password. Empty means no password. Never logged.
THREADROUTE_REDIS_PASSWORD=
# Redis database number.
THREADROUTE_REDIS_DB=0
# Host port that deploy/compose.yaml publishes Redis on (127.0.0.1 only).
# Used only by compose. Change it if 6379 is taken on the host.
THREADROUTE_REDIS_HOST_PORT=6379

# ---------------------------------------------------------------------------
# PostgreSQL, shared by every service that uses it (the router from stage 3).
# PostgreSQL is not in deploy/compose.yaml yet.

# Connection string, as a URL or as key=value pairs. It can hold the
# password and is never logged. The default has no password.
THREADROUTE_POSTGRES_DSN=postgres://threadroute@localhost:5432/threadroute?sslmode=disable
# Most connections in the pool. Each one is a PostgreSQL server process.
THREADROUTE_POSTGRES_MAX_CONNS=8
# How long a service waits at start until PostgreSQL answers.
THREADROUTE_POSTGRES_CONNECT_WAIT=1m

# ---------------------------------------------------------------------------
# normalize (cmd/normalize)

# Consumer group on raw.bluesky.
THREADROUTE_NORMALIZE_GROUP_ID=threadroute-normalize
# Kafka transactional ID. Must be unique per running replica.
THREADROUTE_NORMALIZE_TRANSACTIONAL_ID=threadroute-normalize
# Where a new group starts reading raw.bluesky: beginning or end.
THREADROUTE_NORMALIZE_START=beginning
# Most raw records in one transaction. Not larger than the producer buffer.
THREADROUTE_NORMALIZE_MAX_BATCH_RECORDS=1000
# Lifetime of a deduplication key in Redis (decision 0003). At least 1s.
THREADROUTE_NORMALIZE_DEDUP_KEY_LIFETIME=10m
# How long normalize waits at start for ingest to create raw.bluesky.
THREADROUTE_NORMALIZE_RAW_TOPIC_WAIT=2m
# Listen address of the metrics, pprof and health endpoint.
THREADROUTE_NORMALIZE_METRICS_ADDR=:9466
# Most records the producer keeps in memory before a produce call blocks.
THREADROUTE_NORMALIZE_PRODUCER_MAX_BUFFERED_RECORDS=10000
# Most bytes the producer keeps in memory before a produce call blocks (32 MiB).
THREADROUTE_NORMALIZE_PRODUCER_MAX_BUFFERED_BYTES=33554432
# How long a record may wait for delivery. At least 1s.
THREADROUTE_NORMALIZE_PRODUCER_DELIVERY_TIMEOUT=2m

# ---------------------------------------------------------------------------
# conv (cmd/conv). Windows are measured in source time unless noted.

# Consumer group on events and events.control.
THREADROUTE_CONV_GROUP_ID=threadroute-conv
# Listen address of the metrics, pprof and health endpoint.
THREADROUTE_CONV_METRICS_ADDR=:9467
# How often the sweeper closes conversations (wall-clock time).
THREADROUTE_CONV_SWEEP_INTERVAL=1s
# How long conv waits at start for normalize to create its input topics.
THREADROUTE_CONV_INPUT_TOPIC_WAIT=2m
# N: different customers within the admission window that admit a company.
THREADROUTE_CONV_ADMISSION_THRESHOLD=10
# Sliding window of the admission count.
THREADROUTE_CONV_ADMISSION_WINDOW=1h
# An admission ends after this long without a customer message. Must be
# longer than the inactivity timeout.
THREADROUTE_CONV_ADMISSION_IDLE=2h
# Most admitted companies. 0 means no limit.
THREADROUTE_CONV_COMPANY_LIMIT=0
# A conversation closes after this long without a new message.
THREADROUTE_CONV_INACTIVITY_TIMEOUT=30m
# How long message text stays in Redis after its conversation closed.
THREADROUTE_CONV_TEXT_KEPT_AFTER_CLOSE=10m
# How many of the newest messages of a conversation keep their text.
THREADROUTE_CONV_MESSAGES_KEPT=50
# How long the session record outlives a close.
THREADROUTE_CONV_SESSION_RECORD_KEPT=24h
# How long a deletion that arrived before its message is remembered.
THREADROUTE_CONV_EARLY_DELETION_KEPT=10m
# Wall-clock lifetime of an applied event ID marker.
THREADROUTE_CONV_APPLIED_LIFETIME=7h
# Added to every source-time window to get the wall-clock lifetime of the
# Redis key that holds it.
THREADROUTE_CONV_KEY_MARGIN=7h

# ---------------------------------------------------------------------------
# router (cmd/router). Uses THREADROUTE_KAFKA_BROKERS, THREADROUTE_LOG_LEVEL
# and the THREADROUTE_POSTGRES_ variables above. Routing durations are model
# time: machine time multiplied by the speed factor (decision 0009).

# Consumer group on conversations. A new group starts at the oldest record.
THREADROUTE_ROUTER_GROUP_ID=threadroute-router
# Listen address of the metrics, pprof and health endpoint.
THREADROUTE_ROUTER_METRICS_ADDR=:9468
# Listen address of the operator API. It has no authentication in stage 3,
# so the default binds to localhost only.
THREADROUTE_ROUTER_API_ADDR=127.0.0.1:9470
# How long the router waits at start for conv to create the conversations topic.
THREADROUTE_ROUTER_INPUT_TOPIC_WAIT=2m
# Multiplies the machine clock of every routing timer. 1 for live traffic,
# the replay speed for a load test. Up to 10000.
THREADROUTE_ROUTER_SPEED_FACTOR=1
# Capacity of an operator created without one (1 to 100).
THREADROUTE_ROUTER_OPERATOR_CAPACITY=4
# How long an operator has to accept an offer.
THREADROUTE_ROUTER_ACCEPT_TIMEOUT=20s
# SLA target from entering the queue until an operator accepts.
THREADROUTE_ROUTER_ASSIGNMENT_TARGET=60s
# SLA target until the first reply of the operator.
THREADROUTE_ROUTER_FIRST_RESPONSE_TARGET=120s
# Active load of a company that forms a dedicated team. Above the release load.
THREADROUTE_ROUTER_TEAM_FORM_LOAD=20
# A team is released when the active load stays below this ...
THREADROUTE_ROUTER_TEAM_RELEASE_LOAD=8
# ... for this long.
THREADROUTE_ROUTER_TEAM_RELEASE_AFTER=15m
# Bounds of the team size.
THREADROUTE_ROUTER_TEAM_MIN_SIZE=2
THREADROUTE_ROUTER_TEAM_MAX_SIZE=20
# Number of assignment workers (1 to 64).
THREADROUTE_ROUTER_ASSIGN_WORKERS=4
# How often an idle assignment worker looks at the queues (machine time).
THREADROUTE_ROUTER_ASSIGN_INTERVAL=250ms
# How often offers are checked for the accept timeout, SLA targets for a
# miss, and teams for their size (model time, divided by the speed factor).
THREADROUTE_ROUTER_EXPIRE_INTERVAL=1s
THREADROUTE_ROUTER_SLA_INTERVAL=1s
THREADROUTE_ROUTER_TEAM_INTERVAL=10s
# How often an idle publisher looks at the outbox (machine time).
THREADROUTE_ROUTER_PUBLISH_INTERVAL=100ms
# Most outbox rows sent in one round.
THREADROUTE_ROUTER_PUBLISH_BATCH=500
# How long a sent outbox row is kept, and how often old rows are deleted.
THREADROUTE_ROUTER_OUTBOX_KEEP=1h
THREADROUTE_ROUTER_PRUNE_INTERVAL=1m
# How often the state gauges are sampled from PostgreSQL.
THREADROUTE_ROUTER_COUNTS_INTERVAL=5s
# A loop that fails without a break for this long (database or Kafka down)
# stops the process, so the restart policy starts it again.
THREADROUTE_ROUTER_OUTAGE_LIMIT=2m

# ---------------------------------------------------------------------------
# sim (cmd/sim), the operator simulator. Uses THREADROUTE_KAFKA_BROKERS and
# THREADROUTE_LOG_LEVEL. Behaviour durations are model time: sim divides
# them by the speed factor that it reads from the router at start.

# Base URL of the operator API of the router.
THREADROUTE_SIM_ROUTER_URL=http://127.0.0.1:9470
# How long sim waits at start for the router settings and the routing topic.
THREADROUTE_SIM_START_WAIT=2m
# Consumer group on routing. sim always starts at the end of the topic.
THREADROUTE_SIM_GROUP_ID=threadroute-sim
# Listen address of the metrics, pprof and health endpoint.
THREADROUTE_SIM_METRICS_ADDR=:9469
# When the router has not answered for this long, sim stops with an error,
# so the restart policy starts it again.
THREADROUTE_SIM_OUTAGE_LIMIT=2m
# Number of simulated operators (1 to 9999), IDs sim-op-0001 and so on.
THREADROUTE_SIM_OPERATORS=200
# Language spread as lang:count pairs. Every operator also serves the
# general queue (und). Counts that do not add up to the operator count are
# scaled to it (largest remainder), and every listed language keeps at
# least one operator. A starting value: one measured hour at night (UTC) had
# 98 percent English; it will be tuned after a full-day measurement.
THREADROUTE_SIM_LANGUAGES=en:176,ja:6,de:4,fr:4,es:4,pt:3,ko:3
# Capacity of each operator (1 to 100). 0 takes the router default.
THREADROUTE_SIM_CAPACITY=0
# Shift: online this long, then offline this long, with a random offset
# per operator.
THREADROUTE_SIM_SHIFT_ONLINE=4h
THREADROUTE_SIM_SHIFT_OFFLINE=30m
# Uniform delay before an operator accepts an offer.
THREADROUTE_SIM_ACCEPT_DELAY_MIN=1s
THREADROUTE_SIM_ACCEPT_DELAY_MAX=8s
# Share of offers left to time out on purpose (0 to 1).
THREADROUTE_SIM_MISSED_OFFER_SHARE=0.03
# Medians of the log-normal times from accept to reply and from reply to
# resolve. Each draw is capped at 20 times its median.
THREADROUTE_SIM_HANDLING_MEDIAN=45s
THREADROUTE_SIM_RESOLVE_MEDIAN=3m
# Seed of the random generator. The same seed and the same events give the
# same operator behaviour.
THREADROUTE_SIM_SEED=1
